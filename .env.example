# Copy this file to .env (same folder) and fill in the values.
# .env holds your password, so it is git-ignored and must never be committed.

# Gmail account the server logs in to, to send the enquiry emails.
# Customers never see this address: emails show the customer's name, and Reply goes to the customer.
SMTP_USER=your.gmail.address@gmail.com
# 16-character Gmail App Password (not your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASS=xxxxxxxxxxxxxxxx

# Inbox that RECEIVES the enquiries
ENQUIRY_TO=info@quickreplace.com.au

# Port for the enquiry server (the React dev server forwards /api calls here).
# Do NOT use PORT= here - the React app reads PORT too and would clash.
ENQUIRY_PORT=5000

# Only needed once deployed: the live website address, if the server is hosted on a different domain
# ALLOWED_ORIGIN=https://quickreplace.com.au
